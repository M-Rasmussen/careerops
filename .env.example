# Copy to .env and change the password. .env is git-ignored; never commit it.
POSTGRES_USER=careerops
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=careerops

# Dedicated database used by pytest (must differ from POSTGRES_DB).
TEST_POSTGRES_DB=careerops_test

# API is bound to 127.0.0.1 on this port.
API_PORT=8000

# Dashboard (React) is bound to 127.0.0.1 on this port.
WEB_PORT=5173

# --- Optional AI job matching (leave AI_PROVIDER empty to disable) ---
# Any OpenAI-compatible /chat/completions API. Paid providers bill per token: set limits below.
# Examples: AI_BASE_URL=https://api.openai.com/v1  or  http://host.docker.internal:11434/v1 (Ollama, no key)
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
# Secret: lives only in .env (git-ignored) and the API container; never sent to the frontend.
AI_API_KEY=
AI_MAX_OUTPUT_TOKENS=2000
# max_tokens (most servers, Ollama) or max_completion_tokens (newer OpenAI models that reject max_tokens).
AI_TOKEN_PARAM=max_tokens
# Model round-trips per analysis, per-call timeout, and analyses allowed per rolling 24 hours.
AI_MAX_STEPS=6
AI_TIMEOUT_SECONDS=60
AI_MAX_RUNS_PER_DAY=20

# --- Job discovery (Phase 4B). Runs only when you click Run discovery. ---
# Himalayas remote-jobs API: free, no key. Off by default: Job Discovery now imports jobs directly from employers'
# verified ATS boards. Set to true to bring Himalayas listings back (shown as Himalayas, with its apply links).
DISCOVERY_HIMALAYAS_ENABLED=false
DISCOVERY_HIMALAYAS_MAX_PAGES=1
# Employer board sync: a background worker in the API process works through a PostgreSQL queue. Every verified board
# is checked; overdue boards first. The scheduler re-checks each board every DISCOVERY_SYNC_INTERVAL_HOURS (set
# DISCOVERY_AUTO_SYNC_ENABLED=false to only sync on Run discovery). Run discovery skips boards synced in the last
# DISCOVERY_MIN_RESYNC_MINUTES. DISCOVERY_SYNC_CONCURRENCY boards are fetched at once (each provider host is rate-limited).
DISCOVERY_WORKER_ENABLED=true
DISCOVERY_AUTO_SYNC_ENABLED=true
DISCOVERY_SYNC_INTERVAL_HOURS=24
DISCOVERY_SYNC_CONCURRENCY=2
DISCOVERY_MIN_RESYNC_MINUTES=60
# New boards found in job-feed links and verified per run.
DISCOVERY_MAX_VERIFICATIONS_PER_RUN=5
# Optional JSearch (RapidAPI). Off unless JSEARCH_ENABLED=true AND a key is set. Plans beyond the free tier cost money:
# keep the monthly limit at or below your plan's included requests. Every attempt (including retries) counts.
JSEARCH_ENABLED=false
JSEARCH_API_KEY=
JSEARCH_MONTHLY_REQUEST_LIMIT=100
JSEARCH_MAX_REQUESTS_PER_RUN=5
JSEARCH_CACHE_HOURS=24
