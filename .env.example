# Copy to .env and change the password. .env is git-ignored; never commit it.
POSTGRES_USER=careerops
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=careerops

# Dedicated database used by pytest (must differ from POSTGRES_DB).
TEST_POSTGRES_DB=careerops_test

# API is bound to 127.0.0.1 on this port.
API_PORT=8000

# Dashboard (React) is bound to 127.0.0.1 on this port.
WEB_PORT=5173

# --- Optional AI job matching (leave AI_PROVIDER empty to disable) ---
# Any OpenAI-compatible /chat/completions API. Paid providers bill per token: set limits below.
# Examples: AI_BASE_URL=https://api.openai.com/v1  or  http://host.docker.internal:11434/v1 (Ollama, no key)
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
# Secret: lives only in .env (git-ignored) and the API container; never sent to the frontend.
AI_API_KEY=
AI_MAX_OUTPUT_TOKENS=2000
# max_tokens (most servers, Ollama) or max_completion_tokens (newer OpenAI models that reject max_tokens).
AI_TOKEN_PARAM=max_tokens
# Model round-trips per analysis, per-call timeout, and analyses allowed per rolling 24 hours.
AI_MAX_STEPS=6
AI_TIMEOUT_SECONDS=60
AI_MAX_RUNS_PER_DAY=20
